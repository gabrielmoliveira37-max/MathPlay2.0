rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'provider',
          'role',
          'totalScore',
          'played',
          'badges'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'provider',
          'role',
          'totalScore',
          'played',
          'badges'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.provider in ['password', 'google']
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.played is list
        && request.resource.data.badges is list;
    }

    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && validUserProfile();
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validUserProfile();
      allow delete: if false;
    }
  }
}
